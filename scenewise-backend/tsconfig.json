{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext", // Modern ES Module support for Node.js
    "moduleResolution": "nodenext", // The modern replacement for "node" (Fixes your error)
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true, // Recommended for nodenext
    "sourceMap": true,
    "types": ["node"], // Explicitly includes Node types
    "allowImportingTsExtensions": true,
    "noEmit": true, // IMPORTANT: This must be true when using allowImportingTsExtensions
    "typeRoots": ["./src/types", "./node_modules/@types"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
